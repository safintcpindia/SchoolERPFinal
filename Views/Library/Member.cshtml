@using SchoolERP.Net.Helpers
@inject PermissionHelper PermHelper
@{
    ViewData["Title"] = "Member";

    // Permission loading for the view
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    if (currentUserId > 0) PermHelper.LoadPermissions(currentUserId);

    var canIssue = PermHelper.HasPermissionByUrl("/Library/Member", "Add") || PermHelper.HasPermissionByUrl("/Library/Member", "Edit");
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Members</h6>
    </div>

    <div class="d-flex gap-1">
        <a href="#" class="btn btn-secondary" onclick="window.print()"><i class="ti ti-printer me-1"></i> Print</a>
        <a href="#" class="btn btn-warning"><i class="ti ti-download me-1"></i> Export</a>
        @if (canIssue)
        {
            <a href="javascript:void(0);" id="btnTopIssueReturn" class="btn btn-teal">
                <i class="ti ti-logout me-1"></i>Issue Return
            </a>
        }
    </div>

</div>
<!-- End Page Header -->
<!-- start row -->

<div class="row">

    <div class="col-md-12">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <input type="text" id="searchInput" class="form-control w-25 me-3" placeholder="Search..." />                    
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-12">
        <div class="card shadow-tbl">
            <div class="card-body">
                <div class="tab-content">
                    <!-----System Pane---->
                    <div class="tab-pane active" id="system">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 50px;">#</th>
                                        <th>Member ID</th>
                                        <th>Library Card No</th>
                                        <th>Admission No</th>
                                        <th>Name</th>
                                        <th>Member Type</th>
                                        <th class="text-end">Phone</th>
                                    </tr>
                                </thead>
                                <tbody id="memberTableBody">
                                   


                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-----Student Pane---->
                    <div class="tab-pane" id="std">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            Transport
                                        </td>
                                        <td class="text-end">
                                            <div class="form-check form-switch ">
                                                <input class="form-check-input float-end" type="checkbox" role="switch" id="switchCheckChecked" checked>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            Transport
                                        </td>
                                        <td class="text-end">
                                            <div class="form-check form-switch ">
                                                <input class="form-check-input float-end" type="checkbox" role="switch" id="switchCheckChecked" checked>
                                            </div>
                                        </td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-----Parent Pane---->
                    <div class="tab-pane" id="prt">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            Transport
                                        </td>
                                        <td class="text-end">
                                            <div class="form-check form-switch ">
                                                <input class="form-check-input float-end" type="checkbox" role="switch" id="switchCheckChecked" checked>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            Transport
                                        </td>
                                        <td class="text-end">
                                            <div class="form-check form-switch ">
                                                <input class="form-check-input float-end" type="checkbox" role="switch" id="switchCheckChecked" checked>
                                            </div>
                                        </td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>



                </div>

            </div>
            <!-- end card-body -->
        </div>
        <!-- end card -->
    </div>
    <!-- end col -->

</div>
<!-- end row -->

@section Scripts {
    <script>
        $(document).ready(function () {
            loadMembers();

            $('#searchInput').on('keyup', function () {
                loadMembers($(this).val());
            });

            $('#btnTopIssueReturn').on('click', function () {
                const selected = $('.member-radio:checked');
                if (selected.length === 0) {
                    Swal.fire('Info', 'Please select a member first', 'info');
                    return;
                }
                const id = selected.data('id');
                window.location.href = `/Library/Issue/${id}`;
            });
        });

        function loadMembers(search = '') {
            $.get('/Library/GetMemberList', { type: 'All', search: search }, function (res) {
                if (res.success) {
                    let html = '';
                    res.data.forEach((m, index) => {
                        if (m.libraryCardNo && m.libraryCardNo.length != 0) {
                            html += `
                                    <tr>
                                        <td><input type="radio" name="memberSelect" class="form-check-input member-radio" data-id="${m.libraryMemberID}"></td>
                                        <td>${m.libraryMemberID}</td>
                                        <td>${m.libraryCardNo || '-'}</td>
                                        <td>${m.admissionNo || '-'}</td>
                                        <td>${m.name}</td>
                                        <td>${m.memberType}</td>
                                        <td class="text-end">${m.mobileNo || '-'}</td>
                                    </tr>`;
                        }
                    });
                    $('#memberTableBody').html(html);
                }
            });
        }
    </script>
}

